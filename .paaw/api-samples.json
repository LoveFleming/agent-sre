    {
      "method": "GET",
      "endpoint": "/api/runs",
      "description": "需 X-API-Token header（TASK-015）。列出所有 run 摘要（TASK-004），按 startedAt 新→舊排序。支援 ?agentId= 過濾特定 agent、?limit= 截斷筆數（正整數，0 允許，負數/非整數 → 400）。摘要不含 toolCalls 明細與 error，改回 toolCallCount；含 fingerprint（異常指紋，cooldown 用）。",
      "request": {
        "headers": {
          "X-API-Token": "AGENT_SRE_API_TOKEN 的值"
        },
        "query": {
          "agentId": "（可選）過濾特定 agentId",
          "limit": "（可選）回傳筆數上限，正整數；無效值 → 400 Invalid limit"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "runs": [
