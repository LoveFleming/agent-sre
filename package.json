{
  "name": "agent-sre",
  "version": "1.0.0",
  "description": "AI SRE Agent Crew — standalone Kubernetes/Prometheus/Loki operations",
  "type": "module",
  "main": "server/index.mjs",
  "scripts": {
    "start": "node server/index.mjs",
    "dev": "node --watch server/index.mjs",
    "ui:dev": "cd ui && npx vite",
    "ui:build": "cd ui && npx vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "mock:grafana": "node dev/mocks/grafana-mock.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "node-cron": "^4.6.0"
  }
}
